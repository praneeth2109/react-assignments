{
  "name": "react-assignments",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "cd react-assignments-main/chat-app/server && npm run dev",
    "client": "cd react-assignments-main/chat-app/client && npm run dev",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "cd react-assignments-main/chat-app/client && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
